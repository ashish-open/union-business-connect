# Voice agent (Simran) — see 05_VOICE_AGENT_PLAN.md
#
# Set a DIFFERENT value of VOICE_SHARED_SECRET per environment (dev / preview /
# production) and a matching Sarvam agent version for each. A misconfiguration
# then fails closed instead of pointing a live agent at a preview deploy.

# Bearer token Sarvam presents on every tool call. Store the same value in the
# Sarvam workspace under Settings -> Secrets, never in the tool config itself.
# Minimum 24 chars or routes refuse to serve.
VOICE_SHARED_SECRET=

# HMAC key for the per-call session token. Minimum 32 chars or sessions refuse
# to mint. Rotating this invalidates in-flight calls only, which is harmless.
VOICE_SESSION_SECRET=

# Shared key the rolling six-digit app code is derived from. Minimum 32 chars.
#
# Unlike VOICE_OTP_SECRET below, this has NO fallback — pin.ts throws rather than
# derive a code from a weaker key, because the app and the API must agree on the
# same six digits or the factor is worthless. Leave it unset and the whole PIN
# path dies quietly: /api/voice/pin answers 503, the Today card cannot show a
# code, verify_identity can never accept one, and every caller falls through to
# the SMS fallback — which DOES work, because that one defaults to the session
# secret. So the symptom is "the app code never works" and the cause looks like
# anything but a missing variable. Set it.
VOICE_PIN_SECRET=

# Sarvam's documented egress address. Comma-separated so a second can be added
# without a deploy. Leave EMPTY in local dev (requests arrive via tunnel).
SARVAM_EGRESS_IPS=4.213.167.70

# Number whitelist: mobile:user:role:entityId, comma-separated.
# role is one of owner | accountant | manager
# entityId must match an Entity.id in src/data/seed.ts
#
# The manager entry is deliberate — it is how you prove role caps actually bite
# (a manager's handset must be refused a payout draft). Plan §2.4.
# The voice demo account is first — it is the clean one, built for a phone call.
VOICE_ALLOWED_CALLERS=+918907173502:deepa:owner:chitra-interiors,+919845012345:vikram:owner:nadi-foods,+919700000001:arun:manager:nadi-foods

# Autonomy ceiling: observe | suggest | draft
VOICE_AUTONOMY=draft

# Set to 1 to stop every call at the door. EXPERIENCE_SPEC §10a.
VOICE_KILL_SWITCH=0

# OTP fallback, for callers who can't reach the app. Falls back to
# VOICE_SESSION_SECRET if unset, but set it separately in production.
VOICE_OTP_SECRET=

# Set to 1 to write the OTP into the server log so a demo can be completed.
# NEVER enable this anywhere a real customer can call — an OTP in a log is an OTP.
VOICE_OTP_DEBUG=0

# Sign-in hint. Unset (or anything but "off") shows "Demo: any 6 digits work."
# on /signin; "off" shows a plain "Six digits". signin/page.tsx:35.
#
# NEXT_PUBLIC_, so it is inlined into the client bundle at build time and cannot
# be changed by editing an env var on a running deploy — it needs a rebuild.
NEXT_PUBLIC_DEMO=

# --- Demo escape hatches. Both must be UNSET anywhere real. ---

# A fixed six-digit code that verifies in addition to the rolling one. Set it
# and the caller can read the same digits every time, so a demo does not depend
# on the app being on the right business, the tool passing the digits through,
# and the 90-second window all holding at once. Unset, only the derived code
# works — which is the real design. Every use is logged as voice_demo_pin_used.
VOICE_DEMO_PIN=

# 1 makes a successful verification stick to the call for the rest of it, even
# if the agent platform never writes the upgraded session token back over its own
# variable. verify_identity records the callId that session_start sealed INTO the
# token, so the stale cli_only token the agent keeps sending still identifies the
# call and every later tool is treated as verified.
#
# OFF by default, and it should stay off wherever the mapping works: auth level
# moves from a signed claim to server state, so replaying a cli_only token from a
# verified call within its 30-minute life would be verified too. Turn it on when
# the console is blocking a demo and the mapping will not land; turn it off once
# it does. Logged as voice_sticky_verify_used on every call it affects.
VOICE_STICKY_VERIFY=0

# 1 starts every recognised caller already verified, skipping the PIN entirely.
# The last resort: caller ID is identification, not authentication, so a spoofed
# number would reach every read the role allows. Use only when the step-up
# cannot be wired and a demo is imminent. Logged as voice_step_up_skipped.
VOICE_SKIP_VERIFY=0

# --- Shared draft store (optional but strongly recommended on Vercel) ---
#
# A draft is spoken on a phone and approved in a browser. Without these, that
# state lives in one serverless instance's memory: the call writes it, the
# browser polls a different instance, and the draft is created, logged as
# created, and invisible. Both must be set or neither — absent, the store falls
# back to process memory and behaves exactly as before.
#
# Free tier at upstash.com is far more than this needs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
